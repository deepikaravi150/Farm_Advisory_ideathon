# AWS Core
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit real keys here — this file is tracked in git.
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# OpenAI (LLM + embeddings + speech)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.2
OPENAI_EMBED_MODEL=text-embedding-3-small
# Speech: TTS (text-to-speech) and STT (speech-to-text, Whisper). Defaults shown.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_STT_MODEL=whisper-1

# Qdrant vector DB (RAG)
# In docker-compose the app reaches Qdrant via the service name; when running
# the ingest script from the host use http://localhost:6333
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=farm_docs

# S3
S3_BUCKET_MEDIA=farm-advisor-media
S3_BUCKET_KB=farm-advisor-kb-docs

# SNS
SNS_REGION=ap-south-1

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
CRON_SECRET=change-this-to-a-long-random-cron-secret

# Market prices (Agmarknet via data.gov.in)
# Get a free key at https://data.gov.in. If unset, a shared rate-limited sample
# key is used, which is fine for local testing but not for production.
DATA_GOV_IN_API_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp (Twilio sandbox)
# From the Twilio console: Account SID + Auth Token, and the sandbox sender number.
# Inbound webhook: set "When a message comes in" to https://<your-public-url>/api/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Optional: verify inbound requests really come from Twilio. Enable once your
# public URL is stable, and set WHATSAPP_WEBHOOK_URL to that exact URL.
TWILIO_VALIDATE_SIGNATURE=false
WHATSAPP_WEBHOOK_URL=
